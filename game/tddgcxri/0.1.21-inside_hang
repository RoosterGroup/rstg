            colorBtn.onclick = function() {
                game.bgColor = (game.bgColor + 1) % 4;
                applyBgColor(game.bgColor);
                this.textContent = '当前: ' + colors[game.bgColor];
            };

            // ===== 键盘事件：Y 键打开/关闭作弊面板 =====
            document.addEventListener('keydown', function(e) {
                if (e.key === 'y' || e.key === 'Y') {
                    // 如果焦点在输入框中，不触发
                    let tag = document.activeElement ? document.activeElement.tagName : '';
                    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
                    e.preventDefault();
                    toggleCheatPanel();
                }
                if (e.key === 'Escape') {
                    let overlay = $('cheatOverlay');
                    if (overlay.classList.contains('open')) {
                        toggleCheatPanel(false);
                    }
                }
            });

            // 作弊面板按钮
            $('cheatCloseBtn').onclick = function() { toggleCheatPanel(false) };
            $('cheatCancelBtn').onclick = function() { toggleCheatPanel(false) };
            $('cheatConfirmBtn').onclick = function() { applyCheatChanges() };
            // 点击遮罩关闭
            $('cheatOverlay').addEventListener('click', function(e) {
                if (e.target === this) toggleCheatPanel(false);
            });

            // 启动
            updateUI();
            restartGameLoop();
            setInterval(() => { saveGame(game) }, saveInterval * 1000);
        }

        window.onload = init;
    </script>
</body>
</html>
