        // ============================================================
        // 游戏循环
        // ============================================================
        function gameLoopTick() {
            let g = game,
                dt = Math.min(g.loopRateMs / 1000, 1);
            let tm = g.timeEnabled ? g.timeSpeed : 1;
            if (g.timeEnabled && tm > 1) {
                let cost = (tm - 1) * dt;
                if (g.storedTime >= cost) { g.storedTime -= cost } else { g.storedTime = 0;
                    g.timeEnabled = false;
                    g.timeSpeed = 1 }
            }
            updateProduction(g, dt);
            if (g.autoEnabled && g.autoUnlocked) {
                let baseSpeed = 1;
                if (g.sutBought['111']) baseSpeed = Math.pow(2, g.autoSpeedLevel);
                let effectiveSpeed = baseSpeed * tm;
                let interval = 1 / effectiveSpeed;
                let atkBase = g.mBase.times(g.enhanceMult).times(getAttackExtraMult(g));
                if (interval <= dt) {
                    let total = atkBase.times(effectiveSpeed).times(dt);
                    g.power = g.power.plus(total);
                    g.totalPowerProduced = g.totalPowerProduced.plus(total);
                } else {
                    g.autoAccumulator += dt;
                    while (g.autoAccumulator >= interval) {
                        g.autoAccumulator -= interval;
                        let atk = atkBase.times(tm);
                        g.power = g.power.plus(atk);
                        g.totalPowerProduced = g.totalPowerProduced.plus(atk);
                    }
                }
            }
            RES_DEFS.forEach(def => {
                let r = g.resources[def.id];
                if (!r.unlocked && gte(g.power, def.unlockPower)) r.unlocked = true;
            });
            if (!g.breakUnlocked && gte(g.power, g.breakThreshold)) g.breakUnlocked = true;
            if (!g.autoTabUnlocked && gte(g.power, AUTO_UNLOCK_POWER)) g.autoTabUnlocked = true;
            if (Math.random() < 0.05) saveGame(g);
            updateUI();
        }

        function restartGameLoop() {
            clearInterval(gameLoopTimer);
            gameLoopTimer = setInterval(gameLoopTick, game.loopRateMs);
        }

