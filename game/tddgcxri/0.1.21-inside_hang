            let colors = ['黑色', '白色', '红色', '蓝色'];
            colorBtn.textContent = '当前: ' + colors[game.bgColor];

            // 页面离开时存时间
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) { game._lastLeave = Date.now() } else if (game._lastLeave) {
                    let elapsed = (Date.now() - game._lastLeave) / 1000;
                    if (elapsed > 10) { game.storedTime += elapsed }
                    game._lastLeave = null;
                    updateUI();
                }
            });

            // 主攻击按钮
            $('mainClickBtn').addEventListener('click', () => {
                let atk = game.mBase.times(game.enhanceMult).times(getAttackExtraMult(game));
                let tm = game.timeEnabled ? game.timeSpeed : 1;
                game.power = game.power.plus(atk.times(tm));
                game.totalPowerProduced = game.totalPowerProduced.plus(atk.times(tm));
                updateUI();
            });
            let mainBtn = $('mainClickBtn'),
                timer = null;
            ['mousedown', 'touchstart'].forEach(evt => {
                mainBtn.addEventListener(evt, (e) => {
                    if (evt === 'touchstart') e.preventDefault();
                    let atk = game.mBase.times(game.enhanceMult).times(getAttackExtraMult(game));
                    let tm = game.timeEnabled ? game.timeSpeed : 1;
                    game.power = game.power.plus(atk.times(tm));
                    game.totalPowerProduced = game.totalPowerProduced.plus(atk.times(tm));
                    updateUI();
                    timer = setInterval(() => {
                        let atk2 = game.mBase.times(game.enhanceMult).times(getAttackExtraMult(
                        game));
                        let tm2 = game.timeEnabled ? game.timeSpeed : 1;
                        game.power = game.power.plus(atk2.times(tm2));
                        game.totalPowerProduced = game.totalPowerProduced.plus(atk2.times(tm2));
                        updateUI();
                    }, game.loopRateMs);
                });
            });
            ['mouseup', 'mouseleave', 'touchend'].forEach(evt => mainBtn.addEventListener(evt, () => clearInterval(
            timer)));

