        function applyCheatChanges() {
            let g = game;
            let fields = ['power', 'karma', 'totalKarma', 'mBase', 'enhanceCount', 'amplifyCount', 'breakCount',
                'rebirthCount'
            ];
            fields.forEach(key => {
                let el = $('cheat_' + key);
                if (!el) return;
                let val = el.value.trim();
                if (val === '') return;
                try {
                    if (key === 'enhanceCount' || key === 'amplifyCount' || key === 'breakCount' || key ===
                        'rebirthCount') {
                        let num = parseInt(val, 10);
                        if (!isNaN(num) && num >= 0) {
                            if (key === 'enhanceCount') g.enhanceCount = num;
                            else if (key === 'amplifyCount') g.amplifyCount = num;
                            else if (key === 'breakCount') g.breakCount = num;
                            else if (key === 'rebirthCount') g.rebirthCount = num;
                        }
                    } else {
                        let d = D(val);
                        if (!d.isNaN()) {
                            if (key === 'power') g.power = d;
                            else if (key === 'karma') g.karma = d;
                            else if (key === 'totalKarma') g.totalKarma = d;
                            else if (key === 'mBase') g.mBase = d;
                        }
                    }
                } catch (e) { /* 忽略格式错误 */ }
            });

            // 资源数量
            RES_DEFS.forEach(d => {
                let el = $('cheat_res_' + d.id);
                if (!el) return;
                let val = el.value.trim();
                if (val === '') return;
                try {
                    let dval = D(val);
                    if (!dval.isNaN()) {
                        let r = g.resources[d.id];
                        if (r) r.count = dval;
                    }
                } catch (e) { /* 忽略 */ }
            });

            // 复选框
            g.keepValuesOnRebirth = $('cheatKeepValues').checked;

            // 重算
            computeEnhancedMult(g);
            updateUI();
            $('cheatStatus').textContent = '✓ 所有修改已生效';
            $('cheatStatus').style.color = '#4ade80';
            // 重新填充面板（显示最新值）
            buildCheatPanel();
            // 同步复选框
            $('cheatKeepValues').checked = g.keepValuesOnRebirth;
        }

