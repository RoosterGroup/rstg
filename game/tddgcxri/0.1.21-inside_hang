<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>战力增量 v0.1.21</title>
    <script src="https://cdn.jsdelivr.net/npm/break_eternity.js">
    </script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, sans-serif;
        }
        body {
            background: #000412;
            color: #e6edf7;
            overflow: hidden;
            height: 100vh;
            user-select: none;
            transition: background .3s;
        }
        .page {
            display: none;
            padding: 16px 20px 12px;
            height: 100vh;
            overflow-y: auto;
        }
        .page.active {
            display: block;
        }
        .tab-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }
        .tab {
            padding: 12px 24px;
            background: #1e293b;
            border-radius: 8px;
            cursor: pointer;
            font-size: 18px;
            transition: background .2s;
        }
        .tab.active {
            background: #2563eb;
        }
        .tab.hidden {
            display: none;
        }
        .sub-tab-bar {
            display: flex;
            gap: 6px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }
        .sub-tab {
            padding: 8px 16px;
            background: #1a2332;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            transition: background .2s;
            color: #94a3b8;
        }
        .sub-tab.active {
            background: #1e3a6a;
            color: #e6edf7;
        }
        .sub-page {
            display: none;
        }
        .sub-page.active {
            display: block;
        }
        .top-bar {
            text-align: center;
            padding: 4px 0 6px;
        }
        .top-bar .label {
            font-size: 16px;
        }
        .top-bar .label.power-label {
            color: #2563eb;
        }
        .top-bar .label.karma-label {
            color: #dc2626;
        }
        .power-display {
            font-size: 34px;
            font-family: Consolas, monospace;
            color: #2563eb;
            word-break: break-all;
        }
        .karma-display {
            font-size: 22px;
            font-family: Consolas, monospace;
            color: #dc2626;
            word-break: break-all;
            margin-top: 2px;
        }
        .center-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: calc(100vh - 580px);
            min-height: 100px;
        }
        .click-btn {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            border: none;
            background: #1e40af;
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            box-shadow: 0 0 36px #2563eb80;
            transition: transform .12s, background .2s;
            margin-bottom: 12px;
        }
        .click-btn:active {
            transform: scale(.92);
            background: #2563eb;
        }
        .click-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }
        .bottom-controls {
            position: fixed;
            bottom: 16px;
            left: 16px;
            right: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: center;
        }
        .btn-row {
            display: grid;
            gap: 12px;
            width: 100%;
            max-width: 720px;
            margin: 0 auto;
        }
        .btn-row .btn {
            padding: 16px 20px;
            font-size: 17px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            color: #fff;
            transition: transform .1s, opacity .2s;
            line-height: 1.4;
            text-align: center;
            min-width: 0;
        }
        .btn-row .btn:active {
            transform: scale(.94);
        }
        .btn-row .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }
        .btn-row .btn small {
            display: block;
            font-size: 12px;
            opacity: .85;
            font-weight: 400;
        }
        .btn-red {
            background: #991b1b;
        }
        .btn-green {
            background: #15803d;
        }
        .btn-blue {
            background: #1e40af;
        }
        .btn-purple {
            background: #6b21a8;
        }
        .btn-orange {
            background: #c2410c;
        }
        .btn-cyan {
            background: #0e7490;
        }
        .btn-pink {
            background: #9d174d;
        }
        .btn-indigo {
            background: #4338ca;
        }
        .btn-teal {
            background: #0d9488;
        }
        .btn-amber {
            background: #b45309;
        }
        .btn-gray {
            background: #4b5563;
        }
        .btn-auto {
            background: #0d9488;
        }
        .btn-auto.active {
            background: #047857;
            box-shadow: 0 0 18px #0d9488aa;
        }
        .btn-auto:disabled {
            background: #374151;
        }
        .btn-amplify {
            background: #7c3aed;
        }
        .btn-amplify.active {
            background: #6d28d9;
            box-shadow: 0 0 22px #7c3aedaa;
        }
        .btn-rebirth {
            background: #7f1d1d;
            font-size: 20px;
            padding: 14px 20px;
            line-height: 1.6;
            border: 2px solid #dc2626;
            box-shadow: 0 0 40px #dc262680;
        }
        .btn-rebirth:active {
            transform: scale(.94);
        }
        .btn-rebirth.hidden {
            display: none;
        }
        .resource-box,
        .setting-box,
        .auto-box,
        .stats-box,
        .samsara-box,
        .time-box {
            max-width: 720px;
            margin: 0 auto;
            margin-top: 24px;
            background: #0f172a;
            padding: 22px 24px;
            border-radius: 12px;
            border: 1px solid #273449;
            text-align: center;
        }
        .divider {
            height: 1px;
            background: #334155;
            margin: 14px 0;
        }
        .setting-row {
            margin: 14px 0;
            text-align: left;
        }
        .setting-row input,
        .setting-row textarea {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #475569;
            background: #1e293b;
            color: #e6edf7;
            font-size: 16px;
            font-family: monospace;
            resize: vertical;
        }
        .setting-row button {
            margin-top: 12px;
            padding: 12px 24px;
            background: #991b1b;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }
        .setting-row .save-btn {
            background: #0d9488;
        }
        .tip-text {
            margin-top: 10px;
            font-size: 15px;
            color: #94a3b8;
        }
        .error-text {
            color: #f87171;
        }
        .ok-text {
            color: #4ade80;
        }
        .version-text {
            color: #94a3b8;
            font-size: 16px;
            margin-bottom: 10px;
        }
        .auto-status {
            font-size: 20px;
            margin-top: 8px;
            color: #73c2ff;
        }
        .auto-btn-wrap {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
        .auto-btn-wrap .btn {
            font-size: 20px;
            padding: 18px 40px;
            border-radius: 14px;
        }
        .auto-check-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
            margin-top: 20px;
            font-size: 20px;
        }
        .auto-check-wrap input[type=checkbox] {
            width: 26px;
            height: 26px;
            accent-color: #0d9488;
            cursor: pointer;
        }
        .stats-row {
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 18px;
            text-align: left;
            max-width: 400px;
            margin: 0 auto;
        }
        .stats-row .stat-item {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #273449;
            padding: 8px 0;
        }
        .stats-row .stat-label {
            color: #94a3b8;
        }
        .stats-row .stat-value {
            font-family: Consolas, monospace;
            color: #73c2ff;
            word-break: break-all;
        }
        .stats-row .stat-item.hidden {
            display: none;
        }
        .rate-hint {
            font-size: 14px;
            color: #94a3b8;
            margin-top: 4px;
        }
        .resource-line {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #1e293b;
            font-size: 15px;
            flex-wrap: wrap;
        }
        .resource-line .res-name {
            font-weight: 700;
            color: #94a3b8;
        }
        .resource-line .res-detail {
            color: #e6edf7;
        }
        .top-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }
        .top-buttons .btn {
            font-size: 18px;
            padding: 10px 24px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            color: #fff;
            transition: transform .1s;
            line-height: 1.4;
            text-align: center;
            min-width: 100px;
        }
        .top-buttons .btn:active {
            transform: scale(.94);
        }
        .top-buttons .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }
        .top-buttons .btn small {
            display: block;
            font-size: 12px;
            opacity: .85;
            font-weight: 400;
        }
        .top-buttons .btn .subinfo {
            font-size: 13px;
            opacity: .8;
            font-weight: 400;
            display: block;
            margin-top: 2px;
        }
        .top-buttons .btn.hidden {
            display: none;
        }
        .mid-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 8px 0;
        }
        .mid-buttons .btn {
            font-size: 19px;
            padding: 12px 28px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            color: #fff;
            transition: transform .1s;
            line-height: 1.4;
            text-align: center;
            min-width: 120px;
        }
        .mid-buttons .btn:active {
            transform: scale(.94);
        }
        .mid-buttons .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }
        .mid-buttons .btn small {
            display: block;
            font-size: 12px;
            opacity: .85;
            font-weight: 400;
        }
        .mid-buttons .btn .subinfo {
            font-size: 13px;
            opacity: .8;
            font-weight: 400;
            display: block;
            margin-top: 2px;
        }
        .mid-buttons .btn.hidden {
            display: none;
        }
        .sut-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 16px;
            text-align: left;
        }
        .sut-node {
            background: #1e293b;
            border-radius: 8px;
            padding: 12px;
            border: 2px solid transparent;
            transition: all .2s;
            cursor: pointer;
            position: relative;
        }
        .sut-node.unlocked {
            background: #2a3a5a;
        }
        .sut-node.bought {
            background: #6b1a1a;
            border-color: #dc2626;
        }
        .sut-node.bought .sut-desc,
        .sut-node.bought .sut-effect {
            color: #fca5a5;
        }
        .sut-node.can-buy {
            border-color: #dc2626;
            box-shadow: 0 0 12px #dc2626aa;
        }
        .sut-node.disabled {
            opacity: .4;
            cursor: not-allowed;
            filter: grayscale(.6);
        }
        .sut-node .sut-id {
            font-weight: 700;
            font-size: 16px;
            color: #94a3b8;
        }
        .sut-node .sut-name {
            font-weight: 600;
            font-size: 15px;
            margin: 4px 0;
        }
        .sut-node .sut-desc {
            font-size: 13px;
            color: #94a3b8;
            margin: 4px 0;
        }
        .sut-node .sut-effect {
            font-size: 13px;
            color: #73c2ff;
            margin-top: 4px;
        }
        .sut-node .sut-price {
            font-size: 14px;
            color: #fbbf24;
            margin-top: 6px;
        }
        .samsara-box {
            max-height: 70vh;
            overflow-y: auto;
            text-align: left;
            padding: 16px;
        }
        .samsara-box .sut-grid {
            margin-top: 8px;
        }
        .color-btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: 1px solid #475569;
            cursor: pointer;
            background: #1e293b;
            color: #e6edf7;
            font-size: 16px;
            transition: background .2s;
        }
        .color-btn:hover {
            background: #2a3a5a;
        }
        .time-display {
            font-size: 28px;
            color: #73c2ff;
            margin: 10px 0;
            font-family: Consolas, monospace;
        }
        .time-info {
            font-size: 16px;
            color: #94a3b8;
            margin: 6px 0;
        }
        .time-input {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #475569;
            background: #1e293b;
            color: #e6edf7;
            font-size: 18px;
            font-family: monospace;
            text-align: center;
            margin: 8px 0;
        }
        .time-btn {
            padding: 10px 30px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 18px;
            color: #fff;
            transition: background .2s;
            margin-top: 6px;
        }
        .time-btn.enabled {
            background: #0d9488;
        }
        .time-btn.enabled:hover {
            background: #0f766e;
        }
        .time-btn.disabled {
            background: #4b5563;
            cursor: not-allowed;
            opacity: .6;
        }
        .time-btn.off {
            background: #991b1b;
        }
        .time-btn.off:hover {
            background: #7f1d1d;
        }

        /* ===== 作弊面板（内挂） ===== */
        .cheat-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.72);
            z-index: 9999;
            display: none;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(4px);
            animation: cheatFade .2s ease;
        }
        .cheat-overlay.open {
            display: flex;
        }
        @keyframes cheatFade {
            from {
                opacity: 0;
                transform: scale(.96);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        .cheat-panel {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 16px;
            padding: 28px 32px;
            max-width: 680px;
            width: 95%;
            max-height: 88vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .8);
            color: #e6edf7;
        }
        .cheat-panel::-webkit-scrollbar {
            width: 6px;
        }
        .cheat-panel::-webkit-scrollbar-track {
            background: #1e293b;
            border-radius: 4px;
        }
        .cheat-panel::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        .cheat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #273449;
            padding-bottom: 12px;
            margin-bottom: 18px;
        }
        .cheat-header h2 {
            font-size: 24px;
            font-weight: 600;
            color: #fbbf24;
            letter-spacing: .5px;
        }
        .cheat-header .cheat-close {
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 28px;
            cursor: pointer;
            transition: color .2s;
            line-height: 1;
            padding: 0 6px;
        }
        .cheat-header .cheat-close:hover {
            color: #f87171;
        }
        .cheat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 20px;
        }
        .cheat-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .cheat-item label {
            font-size: 14px;
            color: #94a3b8;
            font-weight: 500;
        }
        .cheat-item input[type="text"],
        .cheat-item input[type="number"] {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #334155;
            background: #1e293b;
            color: #e6edf7;
            font-size: 15px;
            font-family: Consolas, monospace;
            width: 100%;
            transition: border .2s;
        }
        .cheat-item input:focus {
            border-color: #fbbf24;
            outline: none;
        }
        .cheat-item .cheat-hint {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
        }
        .cheat-check {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            border-top: 1px solid #273449;
            margin-top: 4px;
        }
        .cheat-check input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #fbbf24;
            cursor: pointer;
        }
        .cheat-check label {
            font-size: 16px;
            color: #e6edf7;
            cursor: pointer;
        }
        .cheat-check .cheat-check-hint {
            font-size: 13px;
            color: #94a3b8;
            margin-left: 4px;
        }
        .cheat-actions {
            display: flex;
            gap: 14px;
            justify-content: flex-end;
            border-top: 1px solid #273449;
            padding-top: 16px;
            margin-top: 16px;
        }
        .cheat-actions .btn {
            padding: 12px 32px;
            border-radius: 8px;
            border: none;
            font-size: 17px;
            font-weight: 500;
            cursor: pointer;
            transition: transform .1s, opacity .2s;
        }
        .cheat-actions .btn:active {
            transform: scale(.94);
        }
        .cheat-actions .btn-confirm {
            background: #fbbf24;
            color: #0f172a;
        }
        .cheat-actions .btn-confirm:hover {
            background: #fcd34d;
        }
        .cheat-actions .btn-close-panel {
            background: #334155;
            color: #e6edf7;
        }
        .cheat-actions .btn-close-panel:hover {
            background: #475569;
        }
        .cheat-status {
            font-size: 14px;
            color: #4ade80;
            margin-top: 8px;
            text-align: center;
            min-height: 22px;
        }

        @media (max-width: 700px) {
            .sut-grid {
                grid-template-columns: 1fr;
            }
            .btn-row .btn {
                font-size: 15px;
                padding: 14px 12px;
            }
            .power-display {
                font-size: 28px;
            }
            .click-btn {
                width: 140px;
                height: 140px;
                font-size: 22px;
            }
            .center-wrap {
                height: calc(100vh - 520px);
                min-height: 80px;
            }
            .top-buttons .btn,
            .mid-buttons .btn {
                font-size: 16px;
                padding: 8px 16px;
                min-width: 80px;
            }
            .sub-tab {
                padding: 6px 12px;
                font-size: 14px;
            }
            .time-display {
                font-size: 22px;
            }
            .cheat-panel {
                padding: 20px 16px;
            }
            .cheat-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }
            .cheat-actions {
                flex-direction: column;
            }
            .cheat-actions .btn {
                width: 100%;
                text-align: center;
            }
        }

        /* 隐藏广告相关 */
        .htl-badge,
        .htl-report-link,
        [data-html2link-track] {
            display: none !important;
        }
    </style>
</head>
<body>

    <!-- ===== 页面：战斗 ===== -->
    <div id="pageBattle" class="page active">
        <div class="tab-bar">
            <div class="tab active" data-page="pageBattle">战斗</div>
            <div class="tab hidden" data-page="pageAuto">自动化</div>
            <div class="tab hidden" data-page="pageResource">资源</div>
            <div class="tab" data-page="pageStats">统计</div>
            <div class="tab hidden" data-page="pageSamsara">重生</div>
            <div class="tab" data-page="pageSetting">设置</div>
        </div>
        <div class="sub-tab-bar">
            <div class="sub-tab active" data-sub="battleGet">获取</div>
            <div class="sub-tab" data-sub="battleTime">时间</div>
        </div>
        <div class="sub-page active" id="subBattleGet">
            <div class="top-bar">
                <div class="label karma-label" id="karmaLabel" style="display:none;">业力</div>
                <div class="karma-display" id="karmaDisplay" style="display:none;">0</div>
                <div class="label power-label">战力</div>
                <div class="power-display" id="powerText">0</div>
            </div>
            <div class="top-buttons" id="rebirthRow">
                <button class="btn btn-rebirth hidden" id="rebirthBtn">触及至臻之日<br>吾将重生</button>
            </div>
            <div class="center-wrap">
                <button class="click-btn" id="mainClickBtn">攻击</button>
                <div class="mid-buttons" id="actionRow">
                    <button class="btn btn-purple hidden" id="enhanceBtn">强化<small id="enhanceReqLabel">所需：1e5</small><span class="subinfo" id="enhanceSub"></span></button>
                    <button class="btn btn-amplify hidden" id="amplifyBtn">增幅<small id="amplifyReqLabel">需要：1e7</small><span class="subinfo" id="amplifySub"></span></button>
                    <button class="btn btn-red hidden" id="breakBtn">突破<small id="breakReqLabel">需要：1e9</small><span class="subinfo" id="breakSub"></span></button>
                </div>
            </div>
            <div class="bottom-controls">
                <div class="btn-row" id="rowResources"></div>
            </div>
        </div>
        <div class="sub-page" id="subBattleTime">
            <div class="time-box">
                <h3>时间储存</h3>
