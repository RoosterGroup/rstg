        function exportSave() {
            let raw = localStorage.getItem(SAVE_KEY);
            if (!raw) { $('exportTip').textContent = '没有存档数据';
                $('exportTip').className = 'tip-text error-text'; return }
            let encoded = btoa(unescape(encodeURIComponent(raw)));
            let full = 'CombatPowerIncrement' + encoded + 'ArchiveEnd';
            $('importInput').value = full;
            $('exportTip').textContent = '存档编码已生成（含头尾标识），请手动复制';
            $('exportTip').className = 'tip-text ok-text';
        }

        function importSave() {
            let code = $('importInput').value.trim();
            if (!code) { $('importTip').textContent = '请输入编码';
                $('importTip').className = 'tip-text error-text'; return }
            let raw = code;
            if (raw.startsWith('CombatPowerIncrement') && raw.endsWith('ArchiveEnd')) { raw = raw.slice(20, -11) } else {
                $('importTip').textContent = '存档格式错误（缺少头尾标识）';
                $('importTip').className = 'tip-text error-text'; return }
            try {
                let decoded = decodeURIComponent(escape(atob(raw)));
                let obj = JSON.parse(decoded);
                let test = deserializeGame(obj);
                if (test.power === undefined) throw new Error('无效存档');
                localStorage.setItem(SAVE_KEY, decoded);
                game = test;
                computeEnhancedMult(game);
                restartGameLoop();
                updateUI();
                $('importTip').textContent = '存档导入成功！';
                $('importTip').className = 'tip-text ok-text';
            } catch (e) { $('importTip').textContent = '存档格式错误';
                $('importTip').className = 'tip-text error-text' }
        }

