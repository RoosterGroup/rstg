    <script>
        // ============================================================
        // 工具
        // ============================================================
        function D(v) { return (v instanceof Decimal) ? v : new Decimal(v) }

        function fmt(v) {
            if (!(v instanceof Decimal)) v = D(v);
            if (v.eq(0)) return '0';
            let a = v.abs();
            if (a.lt(1e5)) {
                let s = v.toString(),
                    n = parseFloat(s);
                if (!isNaN(n)) { let p = n.toPrecision(6); return parseFloat(p).toString() }
                return s
            }
            let s = v.toExponential(4);
            s = s.replace(/(\.\d*?)0+(?=e)/, '$1');
            s = s.replace(/\.e/, 'e');
            s = s.replace(/e\+/, 'e');
            return s
        }

        function gte(a, b) { return D(a).gte(D(b)) }

        function gt(a, b) { return D(a).gt(D(b)) }

        function lt(a, b) { return D(a).lt(D(b)) }

        function log10(v) { return D(v).log10() }

        function pow(a, b) { return D(a).pow(b) }

        function ln(v) { return D(v).ln() }

        function log2(v) { return D(v).log(2) }

        // ============================================================
        // 常量 & 定义
        // ============================================================
        const SAVE_KEY = 'combat_power_increment';
        const RESET_PASSWORD = '花开花落，曲终人散';
        const REBIRTH_THRESHOLD = D('1.7976e308');
        const AUTO_UNLOCK_POWER = D(1e19);
        const AUTO_PRICE = D(1e20);
        const ENHANCE_INIT_PRICE = D(1e6);
        const BREAK_INIT_THRESHOLD = D(1e10);
        const PRICE_INFLATION_LIMIT = D('1e309');
        const AMPLIFY_BASE_COST = D(1e8);
        const AMPLIFY_BASE_MULT = D(1e10);

        const RES_DEFS_RAW = [
            { id: 'brick', label: '砖', color: 'btn-green', initPrice: 10, priceMult: 100, unlockPower: 10, lowerKey: 'mBase' },
            { id: 'wall', label: '墙', color: 'btn-blue', initPrice: 10000, priceMult: 1000, unlockPower: 10000,
            lowerKey: 'brickMult' },
            { id: 'house', label: '屋', color: 'btn-orange', initPrice: 1e9, priceMult: 1e10, unlockPower: 1e8,
            lowerKey: 'wallMult' },
            { id: 'building', label: '楼', color: 'btn-cyan', initPrice: 1e22, priceMult: 1e12, unlockPower: 1e12,
                lowerKey: 'houseMult' },
            { id: 'street', label: '街', color: 'btn-pink', initPrice: 1e32, priceMult: 1e15, unlockPower: 1e18,
                lowerKey: 'buildingMult' },
            { id: 'city', label: '城', color: 'btn-indigo', initPrice: 1e43, priceMult: 1e18, unlockPower: 1e25,
                lowerKey: 'streetMult' },
            { id: 'country', label: '国', color: 'btn-amber', initPrice: 1e56, priceMult: 1e20, unlockPower: 1e33,
                lowerKey: 'cityMult' },
            { id: 'continent', label: '陆', color: 'btn-teal', initPrice: 1e85, priceMult: 1e25, unlockPower: 1e42,
                lowerKey: 'countryMult' }
        ];
        const RES_DEFS = RES_DEFS_RAW.map(d => ({ ...d, priceMultVar: D(d.priceMult) }));

        const SUT_NODES = {
            '1': { name: '攻击加成', desc: '攻击获得根据历史总获得业力提供的加成', price: 1, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '10': { name: '强化加成', desc: '强化倍率获得根据历史总获得业力提供的加成', price: 2, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '11': { name: '增幅底数优化', desc: '增幅底数获得根据历史总获得业力提供的加成', price: 2, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? D(0.9).div(pow(log10(t), 0.5)) : D(0.9) } },
            '100': { name: '突破公式优化', desc: '突破指数计算改为 1+ln(1+log10(战力)/40)/2.5', price: 3, effect: g => {} },
            '101': { name: '资源不重置倍率', desc: '获得资源不再重置低层次倍率', price: 4, effect: g => {} },
            '110': { name: '资源只扣需求', desc: '获得资源只在当前战力上减去需求值', price: 4, effect: g => {} },
            '111': { name: '自动化加速', desc: '解锁自动化速度优化升级', price: 3, effect: g => {} },
            '1000': { name: '陆加成', desc: '根据历史总获得业力为陆提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1001': { name: '砖加成', desc: '根据历史总获得业力为砖提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1010': { name: '墙加成', desc: '根据历史总获得业力为墙提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1011': { name: '屋加成', desc: '根据历史总获得业力为屋提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1100': { name: '楼加成', desc: '根据历史总获得业力为楼提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1101': { name: '街加成', desc: '根据历史总获得业力为街提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1110': { name: '城加成', desc: '根据历史总获得业力为城提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } },
            '1111': { name: '国加成', desc: '根据历史总获得业力为国提供加成', price: 10, effect: g => { let t = totalKarma(g); return t
                        .gt(1) ? pow(log2(t), 0.5) : D(1) } }
        };

        function childrenOf(c) { return [c + '0', c + '1'] }

        // ============================================================
        // Game 对象
        // ============================================================
        function makeDefaultGame() {
            let g = {
                power: D(0),
                mBase: D(1),
                enhanceCount: 0,
                enhancePrice: D(ENHANCE_INIT_PRICE),
                enhancePriceMult: D(10),
                enhanceMult: D(1),
                amplifyCount: 0,
                amplifyPriceMult: D(AMPLIFY_BASE_MULT),
                amplifyNextCost: D(AMPLIFY_BASE_COST),
                breakCount: 0,
                breakIndex: D(1),
                breakThreshold: D(BREAK_INIT_THRESHOLD),
                breakUnlocked: false,
                autoUnlocked: false,
                autoEnabled: false,
                totalPowerProduced: D(0),
                creationTime: Date.now(),
                rebirthCount: 0,
                maxRebirthPower: D(0),
                rebirthStartTime: Date.now(),
                karma: D(0),
                totalKarma: D(0),
                samsaraUnlocked: false,
                resourceTabUnlocked: false,
                autoTabUnlocked: false,
                loopRateMs: 50,
                columnCount: 4,
                enhanceUsed: false,
                breakUsed: false,
                amplifyUsed: false,
                autoAccumulator: 0,
                autoSpeedLevel: 0,
                sutBought: {},
                sutRevealed: { '1': true },
                dynamicPriceGroup: 10,
                resources: {},
                resourcePriceMultVars: {},
                revealed: { enhance: false, amplify: false, break: false, auto: false, resources: {} },
                bgColor: 0,
                storedTime: 0,
                timeSpeed: 1,
                timeEnabled: false,
                // 作弊标志：重生时保留所有数值
                keepValuesOnRebirth: false
            };
            RES_DEFS.forEach(d => {
                g.resources[d.id] = { count: D(0), mult: D(1), price: D(d.initPrice), unlocked: false };
                g.revealed.resources[d.id] = false;
                g.resourcePriceMultVars[d.id] = D(d.priceMult);
            });
            return g;
        }

        function totalKarma(g) { return g.totalKarma }

        // ============================================================
        // 序列化 / 反序列化
        // ============================================================
        function serializeGame(g) {
            let obj = {
                power: g.power.toString(),
                mBase: g.mBase.toString(),
                enhanceCount: g.enhanceCount,
                enhancePrice: g.enhancePrice.toString(),
                enhancePriceMult: g.enhancePriceMult.toString(),
                enhanceMult: g.enhanceMult.toString(),
                amplifyCount: g.amplifyCount,
                amplifyPriceMult: g.amplifyPriceMult.toString(),
                amplifyNextCost: g.amplifyNextCost.toString(),
                breakCount: g.breakCount,
                breakIndex: g.breakIndex.toString(),
                breakThreshold: g.breakThreshold.toString(),
                breakUnlocked: g.breakUnlocked,
                autoUnlocked: g.autoUnlocked,
                autoEnabled: g.autoEnabled,
                totalPowerProduced: g.totalPowerProduced.toString(),
                creationTime: g.creationTime,
                rebirthCount: g.rebirthCount,
                maxRebirthPower: g.maxRebirthPower.toString(),
                rebirthStartTime: g.rebirthStartTime,
                karma: g.karma.toString(),
                totalKarma: g.totalKarma.toString(),
                samsaraUnlocked: g.samsaraUnlocked,
                resourceTabUnlocked: g.resourceTabUnlocked,
                autoTabUnlocked: g.autoTabUnlocked,
                loopRateMs: g.loopRateMs,
                columnCount: g.columnCount,
                enhanceUsed: g.enhanceUsed,
                breakUsed: g.breakUsed,
                amplifyUsed: g.amplifyUsed,
                autoAccumulator: g.autoAccumulator,
                autoSpeedLevel: g.autoSpeedLevel,
                sutBought: g.sutBought,
                sutRevealed: g.sutRevealed,
                dynamicPriceGroup: g.dynamicPriceGroup,
                revealed: { enhance: g.revealed.enhance, amplify: g.revealed.amplify, break: g.revealed.break,
                    auto: g.revealed.auto, resources: {} },
                resources: {},
                resourcePriceMultVars: {},
                bgColor: g.bgColor,
                storedTime: g.storedTime,
                timeSpeed: g.timeSpeed,
                timeEnabled: g.timeEnabled,
                keepValuesOnRebirth: g.keepValuesOnRebirth
            };
            RES_DEFS.forEach(d => {
                let r = g.resources[d.id];
                obj.resources[d.id] = { count: r.count.toString(), mult: r.mult.toString(), price: r.price.toString(),
                    unlocked: r.unlocked };
                obj.revealed.resources[d.id] = g.revealed.resources[d.id];
                obj.resourcePriceMultVars[d.id] = g.resourcePriceMultVars[d.id].toString();
            });
            return obj;
        }

        function deserializeGame(obj) {
            let g = makeDefaultGame();
            g.power = D(obj.power);
            g.mBase = D(obj.mBase);
            g.enhanceCount = obj.enhanceCount || 0;
            g.enhancePrice = D(obj.enhancePrice);
            g.enhancePriceMult = D(obj.enhancePriceMult || 10);
            g.enhanceMult = D(obj.enhanceMult || 1);
            g.amplifyCount = obj.amplifyCount || 0;
            g.amplifyPriceMult = D(obj.amplifyPriceMult || AMPLIFY_BASE_MULT);
            g.amplifyNextCost = D(obj.amplifyNextCost || AMPLIFY_BASE_COST);
            g.breakCount = obj.breakCount || 0;
            g.breakIndex = D(obj.breakIndex || 1);
            g.breakThreshold = D(obj.breakThreshold || BREAK_INIT_THRESHOLD);
            g.breakUnlocked = !!obj.breakUnlocked;
            g.autoUnlocked = !!obj.autoUnlocked;
            g.autoEnabled = !!obj.autoEnabled;
            g.totalPowerProduced = D(obj.totalPowerProduced || '0');
            g.creationTime = obj.creationTime || Date.now();
            g.rebirthCount = obj.rebirthCount || 0;
            g.maxRebirthPower = D(obj.maxRebirthPower || '0');
            g.rebirthStartTime = obj.rebirthStartTime || Date.now();
            g.karma = D(obj.karma || '0');
            g.totalKarma = D(obj.totalKarma || '0');
            g.samsaraUnlocked = !!obj.samsaraUnlocked;
            g.resourceTabUnlocked = !!obj.resourceTabUnlocked;
            g.autoTabUnlocked = !!obj.autoTabUnlocked;
            g.loopRateMs = obj.loopRateMs || 50;
            g.columnCount = obj.columnCount || 4;
            g.enhanceUsed = !!obj.enhanceUsed;
            g.breakUsed = !!obj.breakUsed;
            g.amplifyUsed = !!obj.amplifyUsed;
            g.autoAccumulator = obj.autoAccumulator || 0;
            g.autoSpeedLevel = obj.autoSpeedLevel || 0;
            g.sutBought = obj.sutBought || {};
            g.sutRevealed = obj.sutRevealed || { '1': true };
            g.dynamicPriceGroup = obj.dynamicPriceGroup || 10;
            if (obj.revealed) {
                g.revealed.enhance = !!obj.revealed.enhance;
                g.revealed.amplify = !!obj.revealed.amplify;
                g.revealed.break = !!obj.revealed.break;
                g.revealed.auto = !!obj.revealed.auto;
                if (obj.revealed.resources) RES_DEFS.forEach(d => { g.revealed.resources[d.id] = !!obj.revealed.resources[d
                        .id] });
            }
            if (obj.resources) RES_DEFS.forEach(d => {
                let r = obj.resources[d.id];
                if (r) {
                    g.resources[d.id].count = D(r.count || '0');
                    g.resources[d.id].mult = D(r.mult || '1');
                    g.resources[d.id].price = D(r.price || d.initPrice);
                    g.resources[d.id].unlocked = !!r.unlocked;
                }
            });
            if (obj.resourcePriceMultVars) RES_DEFS.forEach(d => {
                if (obj.resourcePriceMultVars[d.id]) g.resourcePriceMultVars[d.id] = D(obj.resourcePriceMultVars[d
                .id]);
            });
            g.bgColor = obj.bgColor || 0;
            g.storedTime = obj.storedTime || 0;
            g.timeSpeed = obj.timeSpeed || 1;
            g.timeEnabled = !!obj.timeEnabled;
            g.keepValuesOnRebirth = !!obj.keepValuesOnRebirth;
            return g;
        }

        function saveGame(g) { localStorage.setItem(SAVE_KEY, JSON.stringify(serializeGame(g))) }

        function loadGame() {
            let r = localStorage.getItem(SAVE_KEY);
            if (!r) return null;
            try { return deserializeGame(JSON.parse(r)) } catch (e) { return null }
        }

        // ============================================================
        // 游戏逻辑
        // ============================================================
        function canBuySUT(g, c) {
            let n = SUT_NODES[c];
            if (!n) return false;
            if (g.sutBought[c]) return false;
            let p = c.slice(0, -1);
            if (p && !g.sutBought[p]) return false;
            let price = n.price;
            if (c.startsWith('10') && c.length >= 4) price = g.dynamicPriceGroup;
            return gte(g.karma, price);
        }

        function buySUT(g, c) {
            if (!canBuySUT(g, c)) return;
            let n = SUT_NODES[c];
            if (!n) return;
            let price = n.price;
            if (c.startsWith('10') && c.length >= 4) price = g.dynamicPriceGroup;
            g.karma = g.karma.minus(price);
            g.sutBought[c] = true;
            let kids = childrenOf(c);
            kids.forEach(k => { if (SUT_NODES[k]) g.sutRevealed[k] = true });
            if (c.startsWith('10') && c.length >= 4) { g.dynamicPriceGroup += 10 }
        }

        function computeEnhancedMult(g) {
            let n = g.enhanceCount;
            if (n === 0) { g.enhanceMult = D(1) } else {
                let t = D(0);
                for (let i = 1; i <= n; i++) {
                    let a = D(i).pow(0.55).minus(0.5);
                    if (a.lt(0)) a = D(0);
                    t = t.plus(a);
                }
                g.enhanceMult = D(1).plus(t);
            }
            if (g.sutBought['10']) {
                let tk = totalKarma(g);
                if (tk.gt(1)) g.enhanceMult = g.enhanceMult.times(pow(log2(tk), 0.5));
            }
            let idx = g.breakIndex;
            g.enhanceMult = g.enhanceMult.pow(idx);
        }

        function getAmplifyDiscount(g) {
            let base = D(0.9);
            if (g.sutBought['11']) {
                let tk = totalKarma(g);
                if (tk.gt(1)) base = D(0.9).div(pow(log10(tk), 0.5));
            }
            let idx = g.breakIndex;
            return base.pow(g.amplifyCount).pow(idx);
        }

        function updateBreakIndex(g, p) {
            if (p.lte(1)) { g.breakIndex = D(1); return }
            let logp = log10(p);
            if (logp.lt(0)) { g.breakIndex = D(1); return }
            let inside = D(1).plus(logp.div(40));
            if (g.sutBought['100']) { g.breakIndex = D(1).plus(ln(inside).div(2.5)) } else { g.breakIndex = D(1).plus(ln(
                    inside).div(3.25)) }
            if (g.breakIndex.lt(1)) g.breakIndex = D(1);
        }

        function getDiscountedPrice(b, g) { return b.times(getAmplifyDiscount(g)) }

        function getResourceExtraMult(g, id) {
            let map = { 'continent': '1000', 'brick': '1001', 'wall': '1010', 'house': '1011', 'building': '1100',
                'street': '1101', 'city': '1110', 'country': '1111' };
            let c = map[id];
            if (!c || !g.sutBought[c]) return D(1);
            let tk = totalKarma(g);
            return tk.gt(1) ? pow(log2(tk), 0.5) : D(1);
        }

        function getAttackExtraMult(g) {
            if (!g.sutBought['1']) return D(1);
            let tk = totalKarma(g);
            return tk.gt(1) ? pow(log2(tk), 0.5) : D(1);
        }

        function updateProduction(g, dt) {
            let e = g.enhanceMult;
            let tm = g.timeEnabled ? g.timeSpeed : 1;
            for (let i = RES_DEFS.length - 1; i >= 0; i--) {
                let d = RES_DEFS[i],
                    r = g.resources[d.id];
                if (!r.unlocked || r.count.eq(0)) continue;
                let ex = getResourceExtraMult(g, d.id);
                let c = r.count.times(r.mult).times(e).times(ex).times(dt).times(tm);
                let lk = d.lowerKey;
                if (lk === 'mBase') { g.mBase = g.mBase.plus(c) } else {
                    let ld = RES_DEFS.find(dd => dd.id + 'Mult' === lk || dd.id === lk);
                    if (ld) { let lr = g.resources[ld.id]; if (lr) lr.mult = lr.mult.plus(c) }
                }
            }
        }

        function buyResource(g, id) {
            let d = RES_DEFS.find(dd => dd.id === id);
            if (!d) return;
            let r = g.resources[id];
            if (!r.unlocked) return;
            let price = getDiscountedPrice(r.price, g);
            if (!gte(g.power, price)) return;
            g.power = g.power.minus(price);
            let idx = RES_DEFS.indexOf(d);
            let resetMult = !g.sutBought['101'];
            for (let i = 0; i < idx; i++) {
                let low = RES_DEFS[i],
                    lr = g.resources[low.id];
                lr.count = D(0);
                if (resetMult) lr.mult = D(1);
                lr.price = D(low.initPrice);
            }
            if (!g.sutBought['101']) g.mBase = D(1);
            if (!g.sutBought['110']) g.power = D(0);
            let mult = gte(r.price, PRICE_INFLATION_LIMIT) ? 1.1 : 2;
            r.count = r.count.eq(0) ? D(1) : r.count.times(mult);
            let pmv = g.resourcePriceMultVars[id];
            if (gt(r.price, PRICE_INFLATION_LIMIT)) { pmv = pmv.pow(2);
                g.resourcePriceMultVars[id] = pmv }
            r.price = r.price.times(pmv);
            if (!g.resourceTabUnlocked) g.resourceTabUnlocked = true;
            g.revealed.resources[id] = true;
        }

        function doEnhance(g) {
            let price = getDiscountedPrice(g.enhancePrice, g);
            if (!gte(g.power, price)) return;
            g.power = g.power.minus(price);
            g.enhanceCount += 1;
            g.enhanceUsed = true;
            computeEnhancedMult(g);
            if (gt(g.enhancePrice, PRICE_INFLATION_LIMIT)) g.enhancePriceMult = g.enhancePriceMult.pow(2);
            g.enhancePrice = g.enhancePrice.times(g.enhancePriceMult);
            g.revealed.enhance = true;
        }

        function doAmplify(g) {
            let cost = g.amplifyNextCost;
            if (!gte(g.power, cost)) return;
            g.power = g.power.minus(cost);
            g.amplifyCount += 1;
            g.amplifyUsed = true;
            let mult = g.amplifyPriceMult;
            if (gt(cost, PRICE_INFLATION_LIMIT)) { mult = mult.pow(2);
                g.amplifyPriceMult = mult }
            g.amplifyNextCost = cost.times(mult);
            g.revealed.amplify = true;
        }

        function doBreak(g) {
            if (!gte(g.power, g.breakThreshold)) return;
            let pAt = g.power;
            let keep = ['breakCount', 'breakUnlocked', 'autoUnlocked', 'autoEnabled', 'samsaraUnlocked', 'rebirthCount',
                'maxRebirthPower', 'karma', 'totalKarma', 'creationTime', 'totalPowerProduced', 'rebirthStartTime',
                'enhanceUsed', 'breakUsed', 'amplifyUsed', 'resourceTabUnlocked', 'autoTabUnlocked', 'revealed',
                'sutBought', 'sutRevealed', 'dynamicPriceGroup', 'autoSpeedLevel', 'bgColor', 'storedTime',
                'timeSpeed', 'timeEnabled', 'keepValuesOnRebirth'
            ];
            let saved = {};
            keep.forEach(k => saved[k] = g[k]);
            RES_DEFS.forEach(d => {
                let r = g.resources[d.id];
                r.count = D(0);
                r.mult = D(1);
                r.price = D(d.initPrice);
                r.unlocked = false;
                g.resourcePriceMultVars[d.id] = D(d.priceMult);
            });
            g.mBase = D(1);
            g.power = D(0);
            g.enhanceCount = 0;
            g.enhancePrice = D(ENHANCE_INIT_PRICE);
            g.enhancePriceMult = D(10);
            g.enhanceMult = D(1);
            g.amplifyCount = 0;
            g.amplifyPriceMult = D(AMPLIFY_BASE_MULT);
            g.amplifyNextCost = D(AMPLIFY_BASE_COST);
            g.breakCount = saved.breakCount + 1;
            updateBreakIndex(g, pAt);
            g.breakThreshold = pAt.plus(1);
            delete saved.breakCount;
            Object.assign(g, saved);
            g.breakUnlocked = false;
            g.breakUsed = true;
            computeEnhancedMult(g);
        }

        function doRebirth(g) {
            if (!gte(g.power, REBIRTH_THRESHOLD)) return;
            let l = g.power.log10();
            let kg = D(2).pow(l.div(308.24)).floor();
            g.karma = g.karma.plus(kg);
            g.totalKarma = g.totalKarma.plus(kg);
            g.rebirthCount += 1;
            if (gt(g.power, g.maxRebirthPower)) g.maxRebirthPower = g.power;
            g.rebirthStartTime = Date.now();

            // ---- 作弊：保留所有数值 ----
            if (g.keepValuesOnRebirth) {
                // 只加业力，不重置任何东西
                computeEnhancedMult(g);
                return;
            }

            // ---- 正常重生：重置 ----
            RES_DEFS.forEach(d => {
                let r = g.resources[d.id];
                r.count = D(0);
                r.mult = D(1);
                r.price = D(d.initPrice);
                r.unlocked = false;
                g.resourcePriceMultVars[d.id] = D(d.priceMult);
            });
            g.mBase = D(1);
            g.power = D(0);
            g.enhanceCount = 0;
            g.enhancePrice = D(ENHANCE_INIT_PRICE);
            g.enhancePriceMult = D(10);
            g.enhanceMult = D(1);
            g.amplifyCount = 0;
            g.amplifyPriceMult = D(AMPLIFY_BASE_MULT);
            g.amplifyNextCost = D(AMPLIFY_BASE_COST);
            g.breakCount = 0;
            g.breakIndex = D(1);
            g.breakThreshold = D(BREAK_INIT_THRESHOLD);
            g.breakUnlocked = false;
            g.autoUnlocked = false;
            g.autoEnabled = false;
            g.samsaraUnlocked = true;
            g.enhanceUsed = false;
            g.breakUsed = false;
            g.amplifyUsed = false;
            computeEnhancedMult(g);
            g.storedTime = 0;
            g.timeSpeed = 1;
            g.timeEnabled = false;
        }

        // ============================================================
        // DOM 引用 & 状态
        // ============================================================
        let game = null;
        let frameCount = 0,
            lastFpsUpdate = Date.now(),
            saveInterval = 30;
        let gameLoopTimer = null;

        function $(id) { return document.getElementById(id) }

        function fmtTime(ms) {
            let s = Math.floor(ms / 1000),
                sec = s % 60,
                min = Math.floor(s / 60) % 60,
                h = Math.floor(s / 3600);
            if (h) return h + 'h ' + min + 'm ' + sec + 's';
            if (min) return min + 'm ' + sec + 's';
            return sec + 's';
        }

        function fmtSeconds(sec) {
            let s = Math.floor(sec),
                m = Math.floor(s / 60),
                h = Math.floor(m / 60),
                d = Math.floor(h / 24);
            if (d > 0) return d + 'd ' + h % 24 + 'h ' + m % 60 + 'm ' + s % 60 + 's';
            if (h > 0) return h + 'h ' + m % 60 + 'm ' + s % 60 + 's';
            if (m > 0) return m + 'm ' + s % 60 + 's';
            return s + 's';
        }

        // ============================================================
        // UI 更新
        // ============================================================
        function updateUI() {
            let g = game;
            $('powerText').textContent = fmt(g.power);
            let sk = g.rebirthCount > 0;
            if (sk) { $('karmaLabel').style.display = 'block';
                $('karmaDisplay').style.display = 'block';
                $('karmaDisplay').textContent = fmt(g.karma) } else { $('karmaLabel').style.display = 'none';
                $('karmaDisplay').style.display = 'none' }
            renderSUT();

            // 强化
            if (!g.revealed.enhance && gte(g.power, 1e5)) g.revealed.enhance = true;
            let eb = $('enhanceBtn'),
                er = $('enhanceReqLabel'),
                es = $('enhanceSub');
            if (g.revealed.enhance) {
                eb.classList.remove('hidden');
                let p = getDiscountedPrice(g.enhancePrice, g);
                er.textContent = '所需：' + fmt(p);
                eb.disabled = !gte(g.power, p);
                eb.className = 'btn btn-purple' + (gte(g.power, p) ? '' : ' btn-gray');
                let n = g.enhanceCount + 1,
                    ad = D(n).pow(0.55).minus(0.5);
                if (ad.lt(0)) ad = D(0);
                es.textContent = '增加 +' + ad.toFixed(3);
            } else { eb.classList.add('hidden') }

            // 增幅
            if (!g.revealed.amplify && gte(g.power, 1e7)) g.revealed.amplify = true;
            let ab = $('amplifyBtn'),
                ar = $('amplifyReqLabel'),
                asb = $('amplifySub');
            if (g.revealed.amplify) {
                ab.classList.remove('hidden');
                let c = g.amplifyNextCost;
                ar.textContent = '需要：' + fmt(c);
                ab.disabled = !gte(g.power, c);
                ab.className = 'btn btn-amplify' + (gte(g.power, c) ? ' active' : ' btn-gray');
                asb.textContent = '价格 × ' + fmt(getAmplifyDiscount(g));
            } else { ab.classList.add('hidden') }

            // 突破
            if (!g.revealed.break && gte(g.power, 1e9)) g.revealed.break = true;
            let bb = $('breakBtn'),
                br = $('breakReqLabel'),
                bs = $('breakSub');
            if (g.revealed.break) {
                bb.classList.remove('hidden');
                br.textContent = '需要：' + fmt(g.breakThreshold);
                bb.disabled = !gte(g.power, g.breakThreshold);
                bb.className = 'btn btn-red' + (gte(g.power, g.breakThreshold) ? '' : ' btn-gray');
                let ci = g.breakIndex,
                    fi = D(1);
                if (gte(g.power, g.breakThreshold)) {
                    let p = g.power;
                    if (p.gt(1)) {
                        let logp = log10(p);
                        if (logp.gt(0)) {
                            let inside = D(1).plus(logp.div(40));
                            if (g.sutBought['100']) fi = D(1).plus(ln(inside).div(2.5));
                            else fi = D(1).plus(ln(inside).div(3.25));
                            if (fi.lt(1)) fi = D(1);
                        }
                    }
                }
                let r = fi.div(ci);
                if (r.lt(1)) r = D(1);
                bs.textContent = '突破指数：' + ci.toFixed(4) + ' → ' + fi.toFixed(4) + ' (×' + r.toFixed(3) + ')';
            } else { bb.classList.add('hidden') }

            // 重生按钮
            let rb = $('rebirthBtn');
            if (gte(g.power, REBIRTH_THRESHOLD)) rb.classList.remove('hidden');
            else rb.classList.add('hidden');

            // 资源按钮
            let row = $('rowResources');
            row.innerHTML = '';
            RES_DEFS.forEach(def => {
                let r = g.resources[def.id];
                if (!g.revealed.resources[def.id] && gte(g.power, def.initPrice / 10)) g.revealed.resources[def
                .id] = true;
                if (g.revealed.resources[def.id]) {
                    let btn = document.createElement('button');
                    btn.className = 'btn ' + def.color;
                    let p = getDiscountedPrice(r.price, g);
                    btn.disabled = !(r.unlocked && gte(g.power, p));
                    btn.innerHTML = '获得' + def.label + '<small>需要：' + fmt(p) + '</small>';
                    btn.dataset.id = def.id;
                    btn.addEventListener('click', () => { buyResource(g, def.id);
                        updateUI() });
                    let t = null;
                    btn.addEventListener('mousedown', () => { buyResource(g, def.id);
                        updateUI();
                        t = setInterval(() => { buyResource(g, def.id);
                            updateUI() }, g.loopRateMs) });
                    btn.addEventListener('mouseup', () => clearInterval(t));
                    btn.addEventListener('mouseleave', () => clearInterval(t));
                    btn.addEventListener('touchstart', (e) => { e.preventDefault();
                        buyResource(g, def.id);
                        updateUI();
                        t = setInterval(() => { buyResource(g, def.id);
                            updateUI() }, g.loopRateMs) });
                    btn.addEventListener('touchend', () => clearInterval(t));
                    row.appendChild(btn);
                }
            });
            applyColumnCount();

            // 自动化
            if (!g.revealed.auto && gte(g.power, 1e19)) g.revealed.auto = true;
            if (g.revealed.auto) {
                if (g.autoUnlocked) {
                    $('autoPurchaseArea').style.display = 'none';
                    $('autoControlArea').style.display = 'block';
                    $('autoCheck').checked = g.autoEnabled;
                    $('autoStatus').textContent = g.autoEnabled ? '运行中' : '已停止';
                } else {
                    $('autoPurchaseArea').style.display = 'block';
                    $('autoControlArea').style.display = 'none';
                    let can = gte(g.power, AUTO_PRICE);
                    let abtn = $('autoBtn');
                    abtn.classList.remove('hidden');
                    $('autoReqLabel').textContent = '需要：' + fmt(AUTO_PRICE);
                    abtn.className = 'btn btn-auto' + (can ? '' : ' btn-gray');
                    abtn.disabled = !can;
                    $('autoStatus').textContent = can ? '可购买' : '未解锁';
                }
                if (g.sutBought['111']) {
                    $('autoSpeedArea').style.display = 'block';
                    let lv = g.autoSpeedLevel;
                    $('autoSpeedLevel').textContent = lv === 0 ? 1 : Math.pow(2, lv);
                    let cost = lv === 0 ? 1 : Math.pow(10, lv - 1);
                    $('autoSpeedCost').textContent = '需要：' + cost + '业力';
                    let btn = $('autoSpeedBtn');
                    btn.disabled = !(gte(g.karma, cost));
                    btn.onclick = function() {
                        if (gte(g.karma, cost)) { g.karma = g.karma.minus(cost);
                            g.autoSpeedLevel += 1;
                            updateUI() }
                    };
                } else { $('autoSpeedArea').style.display = 'none' }
            } else { $('autoPurchaseArea').style.display = 'none';
                $('autoControlArea').style.display = 'none';
                $('autoSpeedArea').style.display = 'none' }

            renderResourcePanel();
            renderStatsPanel();
            syncTabs();
            $('rateDisplayHint').textContent = '当前速率：' + g.loopRateMs + ' ms';

            // 时间
            let stored = g.storedTime;
            $('storedTimeDisplay').textContent = fmtSeconds(stored);
            $('storedTimeFull').textContent = fmtSeconds(stored);
            let loopSec = g.loopRateMs / 1000;
            let input = $('timeSpeedInput');
            let val = input.value.trim();
            let speed = 1;
            if (val !== '') {
                let parsed = parseFloat(val);
                if (!isNaN(parsed) && parsed >= 1) {
                    if (val.toLowerCase().includes('e')) { try { speed = parseFloat(val);
                            if (isNaN(speed) || speed < 1) speed = 1 } catch (e) { speed = 1 } } else { speed =
                            parsed;
                        if (speed < 1) speed = 1; }
                } else { speed = 1 }
            } else { speed = 1 }
            let status = $('timeStatusInfo');
            let btn = $('timeToggleBtn');
            let canEnable = speed > 1 && stored >= loopSec;
            if (val === '') { status.textContent = '你目前可以加速 ' + fmt(stored / loopSec) + ' 倍' } else {
                if (speed <= 1) { status.textContent = '请输入 ≥1 的数值' } else {
                    let dur = stored / (speed - 1);
                    let durTicks = Math.floor(dur / loopSec);
                    if (durTicks < 1) { status.textContent = '你目前储存的时间不足以支持该加速' } else {
                        let durSec = durTicks * loopSec;
                        status.textContent = '将时间加速 ' + speed + ' 倍，持续 ' + fmtSeconds(durSec);
                    }
                }
            }
            if (g.timeEnabled && stored < loopSec) { g.timeEnabled = false;
                g.timeSpeed = 1;
                btn.textContent = '禁用';
                btn.className = 'time-btn disabled' } else if (g.timeEnabled && speed > 1 && canEnable) { btn.textContent =
                    '启用';
                btn.className = 'time-btn enabled';
                btn.disabled = false } else if (!g.timeEnabled && canEnable) { btn.textContent = '禁用';
                btn.className = 'time-btn off';
                btn.disabled = false } else { btn.textContent = '禁用';
                btn.className = 'time-btn disabled';
                btn.disabled = true }
            if (g.timeEnabled) { g.timeSpeed = speed }

            frameCount++;
            let now = Date.now();
            if (now - lastFpsUpdate >= 1000) { $('fpsStat').textContent = frameCount;
                frameCount = 0;
                lastFpsUpdate = now }
        }

        // ============================================================
        // SUT
        // ============================================================
        function renderSUT() {
            let g = game,
                container = $('sutTree');
