                if (val !== '') {
                    let parsed = parseFloat(val);
                    if (!isNaN(parsed) && parsed >= 1) {
                        if (val.toLowerCase().includes('e')) { try { speed = parseFloat(val);
                                if (isNaN(speed) || speed < 1) speed = 1 } catch (e) { speed = 1 } } else { speed =
                                parsed;
                            if (speed < 1) speed = 1; }
                    }
                }
                if (!g.timeEnabled && g.storedTime >= g.loopRateMs / 1000 && speed > 1) { g.timeEnabled = true;
                    g.timeSpeed = speed } else if (g.timeEnabled) { g.timeEnabled = false;
                    g.timeSpeed = 1 }
